# Połączenie z MongoDB (Atlas lub własny serwer). Do lokalnych testów: npm run dev:mongo -> mongodb://127.0.0.1:27017/benstal
MONGODB_URI=mongodb://127.0.0.1:27017/benstal

# Logowanie do panelu /panel
ADMIN_EMAIL=admin@benstal.pl
ADMIN_PASSWORD=zmien-to-haslo

# Sekret do podpisywania sesji (min. 32 losowe znaki), np.: openssl rand -hex 32
AUTH_SECRET=zmien-na-losowy-ciag-znakow-min-32-znaki

# Integracja z Order-trackerem (przycisk "Wyślij do Tracker" w /panel). Klucz: Order-tracker -> Ustawienia -> Klucz API
ORDER_TRACKER_URL=https://order-tracker-rouge.vercel.app
ORDER_TRACKER_API_KEY=

# Wysyłka oferty e-mailem (SMTP, np. zenbox: host s51.zenbox.pl, port 465 SSL)
SMTP_HOST=s51.zenbox.pl
SMTP_PORT=465
SMTP_USER=dev@benspa.pl
SMTP_PASS=
# Nadawca widoczny dla klienta (musi być dozwolony na koncie SMTP)
MAIL_FROM="BEN-STAL Garaże <dev@benspa.pl>"
# Opcjonalnie: kopia każdej oferty na skrzynkę firmową
MAIL_BCC=
